# Copy to ~/.openclaw/.env on the OpenClaw VPS (chmod 600). Never commit the real file.

# Discord (Felix bot) — rotate if ever pasted in chat
DISCORD_BOT_TOKEN=

# Hostinger email (SMTP/IMAP skill)
AGENT_EMAIL=you@yourdomain.com
AGENT_EMAIL_PASSWORD=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
DLR_WEBSOLUTIONS_EMAIL_URL=https://mail.hostinger.com

# Optional: Ollama placeholder if your config references it
OLLAMA_API_KEY=ollama-local

# Local image gen (KUBB ComfyUI — see setup/ai-server/05-image-video/local/README.md)
COMFYUI_BASE_URL=http://100.86.160.110:8188
# Optional: exact checkpoint from comfyui_list_models.py
# COMFYUI_CHECKPOINT=your_model.safetensors
# Optional: exported API JSON (built-in graph works without this)
# COMFYUI_WORKFLOW=/home/deploy/AINetwork/setup/ai-server/05-image-video/local/workflows/txt2img_api.json
# Legacy optional file from install-comfyui-workflow.sh:
# COMFYUI_WORKFLOW_API=/home/deploy/.openclaw/comfyui-workflow-api.json
# Optional: exact checkpoint filename (built-in workflow fallback on KUBB)
# COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors

# Crypto watch (CoinGecko ids, comma-separated)
CRYPTO_WATCH_SYMBOLS=bitcoin,ethereum,solana

# Site preview (lead-site trial workflow)
NGROK_AUTHTOKEN=

# Ralph loop — seconds between progress pings on long tasks (default 300 = 5 min)
RALPH_PING_INTERVAL_SEC=300
