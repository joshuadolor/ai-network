# Copy to start_comfyui.env and edit paths for your machine.
# Load: set -a && source ./start_comfyui.env && set +a && ./start_comfyui.sh
#
# --- Linux VPS (Ubuntu) ---
#   COMFYUI_ROOT=/home/ubuntu/ComfyUI
#
# --- Windows Git Bash ---
#   Use /c/Users/... not /home/...  (Git Bash has no /home/Josh)
#   C:\Users\You\ComfyUI  →  /c/Users/You/ComfyUI
#   Check:  cd /c/Users/You/ComfyUI && pwd

# Absolute path to ComfyUI install (directory containing main.py)
COMFYUI_ROOT=/home/REPLACE_USER/ComfyUI

# Virtualenv directory (default: $COMFYUI_ROOT/venv, else .venv)
COMFYUI_VENV=/home/REPLACE_USER/ComfyUI/venv

# Bind address and port (0.0.0.0 = all interfaces; default port 8188)
COMFYUI_LISTEN=0.0.0.0
COMFYUI_PORT=8188

# Supervisor + ComfyUI log file
COMFYUI_LOG=/home/REPLACE_USER/ComfyUI/comfyui_server.log

# Seconds to wait before restarting after exit or crash
COMFYUI_RESTART_DELAY=10

# Optional extra flags for main.py (single line, space-separated)
# COMFYUI_EXTRA_ARGS=--preview-method auto

# --- ComfyUI Desktop on Windows (Git Bash) ---
# Code and data are split; see Documents/ComfyUI/user/comfyui_*.log for paths.
# COMFYUI_ROOT=/c/Users/REPLACE_USER/AppData/Local/Programs/ComfyUI/resources/ComfyUI
# COMFYUI_VENV=/c/Users/REPLACE_USER/Documents/ComfyUI/.venv
# COMFYUI_EXTRA_ARGS="--base-directory /c/Users/REPLACE_USER/Documents/ComfyUI --front-end-root /c/Users/REPLACE_USER/AppData/Local/Programs/ComfyUI/resources/ComfyUI/web_custom_versions/desktop_app"
# COMFYUI_LOG=/c/Users/REPLACE_USER/Documents/ComfyUI/comfyui_server.log
#
# For comfyui_generate.py (local/ or OpenClaw skill), after installing a checkpoint:
# COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors
