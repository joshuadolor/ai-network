# Copy to open-webui.env on the apps VPS (never commit open-webui.env).

# KUBB Ollama over Tailscale
OLLAMA_BASE_URL=http://100.86.160.110:11434

# ComfyUI on KUBB (verified: curl -s http://100.86.160.110:8188/system_stats)
ENABLE_IMAGE_GENERATION=true
COMFYUI_BASE_URL=http://100.86.160.110:8188/

# Optional: path on apps VPS to API-format workflow JSON, or configure in Admin → Settings → Images
# COMFYUI_WORKFLOW=/path/to/txt2img-api.json
